# Variáveis públicas embutidas no build (import.meta.env.PUBLIC_*).
# Não coloque o Personal Access Token aqui — o PAT só existe no navegador, em runtime.

PUBLIC_GITHUB_OWNER=sennaricarte
PUBLIC_GITHUB_REPO=cliente-exemplo-astro
PUBLIC_GITHUB_BRANCH=main
PUBLIC_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxxxxxxx/yyyyyyyy

# HTTP Basic do /admin — SOMENTE no Edge Middleware da Vercel.
# NUNCA use prefixo PUBLIC_: essas variáveis não podem ir para o bundle do cliente.
# Em produção, configure em Vercel > Project Settings > Environment Variables
# (não commite um .env com esses valores).
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
