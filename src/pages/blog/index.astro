---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import SiteNav from '../../components/SiteNav.astro';

const articles = (await getCollection('articles')).sort(
  (left, right) => right.data.publishedDate.valueOf() - left.data.publishedDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Últimos artigos" canonicalPath="/blog">
  <SiteNav />
  <main class="blog-index">
    <h1>Blog</h1>
    <p class="blog-index__intro">Últimos artigos</p>
    {
      articles.length > 0 ? (
        <ul class="blog-index__list">
          {articles.map((article) => (
            <li>
              <article class="blog-card">
                <a href={`/blog/${article.data.slug}`}>
                  <Image
                    src={article.data.featuredImage.src}
                    alt={article.data.featuredImage.alt}
                    format="webp"
                    quality="mid"
                    loading="lazy"
                  />
                  <h2>{article.data.title}</h2>
                </a>
                <p>{article.data.excerpt}</p>
                <time datetime={article.data.publishedDate.toISOString()}>
                  {article.data.publishedDate.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
                </time>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p>Nenhum artigo publicado ainda.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .blog-index {
    padding: var(--space-5) var(--space-4);
    max-width: 48rem;
  }

  .blog-index h1 {
    font-family: var(--font-secondary);
    color: var(--color-primary);
  }

  .blog-index__intro {
    margin: var(--space-1) 0 var(--space-4);
    color: var(--color-secondary);
  }

  .blog-index__list {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .blog-card a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card h2 {
    margin-top: var(--space-2);
    color: var(--color-primary);
  }

  .blog-card a:hover h2,
  .blog-card a:focus-visible h2 {
    color: var(--color-accent);
  }

  .blog-card p {
    margin-top: var(--space-1);
    color: var(--color-secondary);
  }

  .blog-card time {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  .blog-card :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
</style>
