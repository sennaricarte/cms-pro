---
interface Props {
  title?: string;
}

const { title = 'Admin' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <div class="admin-shell">
      <slot />
      <p class="admin-footnote">
        O token fica no localStorage deste navegador. Use um PAT fine-grained restrito a este
        único repositório, com permissão apenas de Contents (read/write), e defina uma data de
        expiração ao gerá-lo no GitHub.
      </p>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --admin-bg: #f3f4f6;
    --admin-card: #ffffff;
    --admin-text: #111827;
    --admin-muted: #6b7280;
    --admin-accent: #2563eb;
    --admin-danger: #b91c1c;
    --admin-border: #e5e7eb;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
  }

  body {
    min-height: 100vh;
    font-family: system-ui, sans-serif;
    background: var(--admin-bg);
    color: var(--admin-text);
  }

  .admin-shell {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .admin-app {
    display: grid;
    gap: 1.25rem;
  }

  .admin-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .admin-tabs__item {
    margin-top: 0;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--admin-border);
    border-radius: 999px;
    background: transparent;
    color: var(--admin-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .admin-tabs__item.is-active {
    background: var(--admin-accent);
    border-color: var(--admin-accent);
    color: #fff;
  }

  .admin-card {
    background: var(--admin-card);
    border: 1px solid var(--admin-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .admin-card h1 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .admin-card p {
    color: var(--admin-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .admin-card form {
    display: grid;
    gap: 0.5rem;
  }

  .admin-card label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .admin-card input,
  .admin-textarea {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
    font: inherit;
    background: #fff;
  }

  .admin-textarea {
    resize: vertical;
    line-height: 1.5;
  }

  .admin-textarea--body {
    min-height: 18rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
  }

  .admin-button {
    margin-top: 0.5rem;
    padding: 0.7rem 1rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--admin-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .admin-button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .admin-button--ghost {
    background: transparent;
    color: var(--admin-text);
    border: 1px solid var(--admin-border);
  }

  .admin-error {
    margin-top: 1rem;
    color: var(--admin-danger);
  }

  .admin-footnote {
    margin-top: 1.5rem;
    color: var(--admin-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .admin-dashboard {
    display: grid;
    gap: 1.25rem;
  }

  .admin-dashboard__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-dashboard__eyebrow {
    color: var(--admin-muted);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .admin-banner {
    background: #fef3c7;
    color: #92400e;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
  }

  .admin-banner--info {
    background: #eff6ff;
    color: #1e3a8a;
  }

  .admin-section + .admin-section {
    margin-top: 0;
  }

  .admin-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .admin-section__header h2 {
    font-size: 1.1rem;
  }

  .admin-section__header .admin-button {
    margin-top: 0;
  }

  .admin-empty {
    color: var(--admin-muted);
    margin: 0;
  }

  .admin-skeleton {
    display: grid;
    gap: 0.65rem;
  }

  .admin-skeleton span {
    display: block;
    height: 2.5rem;
    border-radius: 0.375rem;
    background: linear-gradient(90deg, #e5e7eb 25%, #f3f4f6 50%, #e5e7eb 75%);
    background-size: 200% 100%;
    animation: admin-shimmer 1.2s ease-in-out infinite;
  }

  @keyframes admin-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  .admin-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .admin-list__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-list__item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .admin-list__name {
    font-weight: 600;
  }

  .admin-editor {
    display: grid;
    gap: 1.25rem;
  }

  .admin-editor__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin-editor__header .admin-button {
    margin-top: 0;
  }

  .admin-card.admin-form {
    display: grid;
    gap: 1.1rem;
  }

  .admin-field {
    display: grid;
    gap: 0.4rem;
  }

  .admin-field label,
  .admin-field > span {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .admin-field--invalid input,
  .admin-field--invalid textarea {
    border-color: var(--admin-danger);
  }

  .admin-card .admin-field__hint,
  .admin-card .admin-field__count {
    margin: 0;
    color: var(--admin-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .admin-field__count--warn,
  .admin-field__error {
    color: var(--admin-danger);
  }

  .admin-field__error {
    margin: 0;
    font-size: 0.8125rem;
  }

  .admin-field__hint code {
    font-size: 0.8125rem;
  }

  .admin-editor__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .admin-editor__actions .admin-button {
    margin-top: 0;
  }

  .admin-list__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-list__actions .admin-button {
    margin-top: 0;
    padding: 0.45rem 0.75rem;
    font-size: 0.875rem;
  }

  .admin-list__confirm {
    font-size: 0.875rem;
    color: var(--admin-danger);
  }

  .admin-button--danger {
    background: var(--admin-danger);
  }

  .admin-media-upload {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-media-upload .admin-button {
    justify-self: start;
    margin-top: 0;
  }

  .admin-media-upload__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--admin-muted);
  }

  .admin-spinner {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--admin-border);
    border-top-color: var(--admin-accent);
    border-radius: 50%;
    animation: admin-spin 0.7s linear infinite;
  }

  @keyframes admin-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .admin-media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .admin-media-card {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .admin-media-card img,
  .admin-media-picked img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.5rem;
    background: var(--admin-bg);
  }

  .admin-media-picked {
    display: grid;
    gap: 0.4rem;
  }

  .admin-media-picked img {
    max-width: 12rem;
    aspect-ratio: 16 / 10;
  }

  .admin-media-card__name {
    margin: 0;
    font-weight: 600;
    color: var(--admin-text);
    word-break: break-all;
  }

  .admin-media-card__alt {
    display: grid;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--admin-muted);
  }

  .admin-media-picker {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow: auto;
    padding: 1.5rem 1rem;
    background: rgb(17 24 39 / 0.45);
  }

  .admin-media-picker__panel {
    max-width: 56rem;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    background: var(--admin-card);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .admin-media-picker .admin-editor__header h2 {
    font-size: 1.1rem;
  }

  .admin-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .admin-checkbox input {
    width: auto;
    margin: 0;
  }

  .admin-blocks {
    display: grid;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .admin-block-list {
    display: grid;
    gap: 1rem;
  }

  .admin-block {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid var(--admin-border);
    border-radius: 0.75rem;
    background: #f9fafb;
  }

  .admin-block__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .admin-block__header h3 {
    margin: 0;
    font-size: 1rem;
  }

  .admin-block__body {
    display: grid;
    gap: 0.9rem;
  }

  .admin-block-add {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .admin-block-add .admin-button {
    margin-top: 0;
  }

  .admin-block-menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .admin-gallery-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .admin-gallery-item {
    display: grid;
    gap: 0.65rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-gallery-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .admin-error-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--admin-danger);
    display: grid;
    gap: 0.35rem;
  }

  .admin-settings {
    display: grid;
    gap: 1.25rem;
  }

  .admin-settings__layout {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .admin-settings__layout {
      grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
      align-items: start;
    }

    .admin-theme-preview {
      position: sticky;
      top: 1rem;
    }
  }

  .admin-theme-preview {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--admin-border);
    border-radius: 0.75rem;
  }

  .admin-theme-preview__label {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .admin-theme-preview img {
    max-width: 8rem;
    max-height: 4rem;
    object-fit: contain;
  }

  .admin-theme-preview__name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .admin-theme-preview__placeholder {
    margin: 0;
    opacity: 0.65;
  }

  .admin-theme-preview button {
    justify-self: start;
    border: 0;
    border-radius: 0.375rem;
    padding: 0.65rem 0.9rem;
    font: inherit;
    font-weight: 600;
  }

  .admin-fieldset {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 1rem 0 0;
    border: 0;
    border-top: 1px solid var(--admin-border);
  }

  .admin-fieldset--plain {
    padding-top: 0;
    border-top: 0;
  }

  .admin-fieldset legend {
    padding: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .admin-color-grid {
    display: grid;
    gap: 0.9rem;
  }

  .admin-color-row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.5rem;
    align-items: center;
  }

  .admin-color-row input[type='color'] {
    width: 3rem;
    height: 2.5rem;
    padding: 0.15rem;
    cursor: pointer;
  }

  .admin-weight-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
  }

  .admin-repeat-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .admin-repeat-row {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-repeat-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .admin-repeat-row .admin-button {
    justify-self: start;
    margin-top: 0;
  }

  .admin-card select {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
    font: inherit;
    background: #fff;
  }
</style>
